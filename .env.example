# Copy this file to .env.local and fill in what you have.
# Leave everything blank to run in DEMO MODE (data stays in your browser, AI off).

# --- Supabase: sign-in, saved projects, file storage -------------------------
# Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- OpenAI: AI scope drafting and AI review (optional) ----------------------
# Server-side only. Never prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# AI routes require a signed-in user. For local testing WITHOUT Supabase,
# set this to true. Never enable it on a public deployment.
ALLOW_AI_WITHOUT_LOGIN=false
